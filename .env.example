# Copy to .env for local overrides. Never commit .env.
# GuardRail is Devnet-only; this only overrides the Devnet RPC endpoint.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Devnet demo setup panel (off unless EXPO_PUBLIC_DEMO_SETUP=1). Public addresses printed by
# `npm run fixture:wallet:create`. Leave unset for normal builds.
# EXPO_PUBLIC_DEMO_SETUP=1
# EXPO_PUBLIC_DEMO_MINT=
# EXPO_PUBLIC_DEMO_DELEGATE=
